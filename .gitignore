# OS files
.DS_Store
*/.DS_Store

# Node (workspace root + web/)
node_modules/
web/.next/
web/out/
web/next-env.d.ts
*.tsbuildinfo
npm-debug.log*

# Python
__pycache__/
*.py[cod]
.venv/
dist/
build/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
